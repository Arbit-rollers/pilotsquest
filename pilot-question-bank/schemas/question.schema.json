{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pilot-question-bank/schemas/question.schema.json",
  "title": "Pilot Theory Examination Question",
  "description": "Canonical record for one usable or quarantined pilot theory exam question. One JSON object per line in the authority JSONL files (data/<authority>/.../*.jsonl).",
  "type": "object",
  "required": [
    "question_id",
    "authority",
    "country_or_region",
    "licence",
    "subject",
    "question_type",
    "question_text",
    "choices",
    "correct_answer",
    "explanation",
    "difficulty",
    "provenance",
    "source_title",
    "source_url",
    "copyright_status",
    "reuse_allowed",
    "verified",
    "last_verified"
  ],
  "properties": {
    "question_id": {
      "type": "string",
      "description": "Format: <AUTHORITY>-<LICENCECODE>-<SUBJECTCODE>-<sequence>, e.g. EASA-PPLA-AL-000001",
      "pattern": "^[A-Z0-9]+-[A-Z0-9]+-[A-Z0-9]+-[0-9]{6}$"
    },
    "authority": {
      "type": "string"
    },
    "country_or_region": {
      "type": "string"
    },
    "licence": {
      "type": "string",
      "description": "Authority's own licence code, verbatim (e.g. PPL(A), LAPL(A), Part 61 PPL)"
    },
    "track_id": {
      "type": "string",
      "description": "<AUTHORITY>:<LICENCE> key from taxonomy/licences.json, e.g. EASA:ATPL(A)"
    },
    "licence_level": {
      "type": "string",
      "enum": [
        "recreational",
        "private",
        "commercial",
        "airline_transport",
        "instructor",
        "remote_pilot"
      ]
    },
    "aircraft_class": {
      "type": "string",
      "enum": [
        "aeroplane",
        "helicopter",
        "glider",
        "ultralight",
        "uas"
      ]
    },
    "applicable_licences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Every track_id this question is valid study material for (own track first)."
    },
    "subject_code": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "chapter_number": {
      "type": "integer"
    },
    "chapter_title": {
      "type": "string",
      "description": "Chapter/section within the subject. Backfilled from `subject` by scripts/categorize.py when the source has none."
    },
    "topic": {
      "type": "string",
      "enum": [
        "AIR_LAW",
        "AGK_AIRFRAME_SYSTEMS",
        "AGK_POWERPLANT",
        "INSTRUMENTS",
        "MASS_BALANCE",
        "PERFORMANCE",
        "FLIGHT_PLANNING",
        "HUMAN_PERFORMANCE",
        "METEOROLOGY",
        "GENERAL_NAVIGATION",
        "RADIO_NAVIGATION",
        "OPERATIONAL_PROCEDURES",
        "PRINCIPLES_OF_FLIGHT",
        "COMMUNICATIONS",
        "INSTRUCTION"
      ],
      "description": "Cross-authority study area (taxonomy/topics.json). Derived by scripts/categorize.py unless topic_source = explicit."
    },
    "topic_name": {
      "type": "string"
    },
    "topic_source": {
      "type": "string",
      "enum": [
        "explicit",
        "override",
        "rule"
      ]
    },
    "syllabus_version": {
      "type": "string"
    },
    "learning_objective_code": {
      "type": "string"
    },
    "learning_objective": {
      "type": "string"
    },
    "question_type": {
      "type": "string",
      "enum": [
        "single_choice",
        "multiple_response",
        "true_false",
        "calculation",
        "chart_plotting",
        "short_answer"
      ]
    },
    "question_text": {
      "type": "string",
      "minLength": 1
    },
    "choices": {
      "type": "array",
      "minItems": 0,
      "description": "Required (>=2 items) for single_choice/multiple_response/true_false. Empty for short_answer/calculation questions, whose correct_answer is a free-text string instead of a choice label.",
      "items": {
        "type": "object",
        "required": [
          "label",
          "text"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "correct_answer": {
      "description": "Choice label (single_choice) or array of labels (multiple_response)",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "explanation": {
      "type": "string"
    },
    "incorrect_answer_explanations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "regulation_reference": {
      "type": "string"
    },
    "handbook_reference": {
      "type": "string"
    },
    "calculation_steps": {
      "type": "string"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "question_style": {
      "type": "string",
      "enum": [
        "exam_style",
        "concept_recall"
      ],
      "description": "concept_recall = templated recall item: flashcards only, never exam practice."
    },
    "quality_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Open quality/licensing issues. Derived; see scripts/taxonomy.py quality_flags()."
    },
    "aircraft_category": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "default": "en"
    },
    "provenance": {
      "type": "string",
      "enum": [
        "official_released",
        "official_sample",
        "public_domain",
        "open_licensed",
        "original_syllabus_aligned",
        "third_party_reference_only",
        "restricted_do_not_use",
        "provenance_uncertain"
      ]
    },
    "source_title": {
      "type": "string"
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "source_location": {
      "type": "string"
    },
    "copyright_status": {
      "type": "string"
    },
    "reuse_allowed": {
      "type": "boolean",
      "description": "Derived from the rights record and policy; never trusted from imported data."
    },
    "verified": {
      "type": "boolean",
      "description": "Derived: true only when every applicable review has passed."
    },
    "last_verified": {
      "type": "string",
      "format": "date"
    },
    "duplicate_group_id": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "media": {
      "type": "array",
      "description": "Media assets (images/charts/diagrams/audio) required to answer this question. Mirrors the media table in database_schema.sql.",
      "items": {
        "type": "object",
        "required": [
          "media_type",
          "file_path",
          "alt_text",
          "licence"
        ],
        "properties": {
          "media_type": {
            "type": "string",
            "enum": [
              "image",
              "chart",
              "diagram",
              "audio",
              "video",
              "document"
            ]
          },
          "file_path": {
            "type": "string"
          },
          "alt_text": {
            "type": "string"
          },
          "attribution": {
            "type": "string"
          },
          "licence": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "quarantined",
        "restricted_do_not_use",
        "historical_reference_only",
        "superseded",
        "rejected",
        "archived"
      ],
      "default": "quarantined",
      "description": "Computed by scripts/gates.py — never set by hand or by import."
    },
    "source_record_id": {
      "type": "string"
    },
    "source_id": {
      "type": "string",
      "description": "Registered source (sources/source_manifest.json)"
    },
    "source_pdf_filename": {
      "type": "string"
    },
    "source_page": {
      "type": [
        "integer",
        "string",
        "null"
      ]
    },
    "source_question_number": {
      "type": "string"
    },
    "source_answer_page": {
      "type": [
        "integer",
        "null"
      ]
    },
    "source_raw_file": {
      "type": "string"
    },
    "source_has_answer_key": {
      "type": "boolean"
    },
    "original_question_text": {
      "type": "string"
    },
    "original_choices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "original_stated_answer": {
      "type": [
        "string",
        "array"
      ]
    },
    "original_explanation": {
      "type": "string"
    },
    "source_subject_label": {
      "type": "string",
      "description": "Source's own subject label when categorize.py corrected it"
    },
    "extraction_method": {
      "type": "string",
      "enum": [
        "native_text",
        "ocr",
        "manual"
      ]
    },
    "extraction_confidence": {
      "type": [
        "number",
        "null"
      ]
    },
    "answer_match_confidence": {
      "type": [
        "number",
        "null"
      ]
    },
    "ocr_uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "regulatory_status": {
      "type": "string",
      "enum": [
        "",
        "current_verified",
        "current_pending_second_review",
        "outdated_but_corrected",
        "historical_reference_only",
        "superseded",
        "jurisdiction_uncertain",
        "quarantined",
        "rejected"
      ]
    },
    "regulatory_note": {
      "type": "string"
    },
    "regulation_provision": {
      "type": "string"
    },
    "source_effective_date": {
      "type": "string"
    },
    "source_accessed_date": {
      "type": "string"
    },
    "rights_record_id": {
      "type": "string",
      "description": "taxonomy/rights_records.csv"
    },
    "technical_review_status": {
      "type": "string",
      "enum": [
        "pending",
        "passed",
        "failed"
      ]
    },
    "technical_review_evidence": {
      "type": "string"
    },
    "second_check_status": {
      "type": "string",
      "enum": [
        "pending",
        "passed",
        "failed",
        "not_required"
      ]
    },
    "regulatory_review_status": {
      "type": "string",
      "enum": [
        "pending",
        "passed",
        "failed",
        "not_applicable"
      ]
    },
    "editorial_review_status": {
      "type": "string",
      "enum": [
        "pending",
        "passed",
        "failed"
      ]
    },
    "media_review_status": {
      "type": "string",
      "enum": [
        "pending",
        "passed",
        "failed",
        "not_required"
      ]
    },
    "duplicate_review_status": {
      "type": "string",
      "enum": [
        "pending",
        "passed",
        "failed"
      ]
    },
    "similarity_score": {
      "type": [
        "number",
        "null"
      ]
    },
    "question_version": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes_question_id": {
      "type": "string"
    },
    "superseded_by_question_id": {
      "type": "string"
    },
    "active_study_bank": {
      "type": "boolean"
    },
    "pipeline_state": {
      "type": "string",
      "enum": [
        "received",
        "extracted",
        "answer_matched",
        "classified",
        "rights_reviewed",
        "technically_verified",
        "regulatorily_verified",
        "media_verified",
        "duplicate_reviewed",
        "approved",
        "active"
      ]
    },
    "gate_failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": "string"
    },
    "hold_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "shuffle_algorithm": {
      "type": "string"
    },
    "shuffle_seed": {
      "type": "string"
    },
    "source_payload": {
      "type": "object",
      "description": "Imported fields not yet mapped to the schema (guide section 12)"
    },
    "image_required": {
      "type": "boolean"
    },
    "image_answer_dependency": {
      "type": "string"
    },
    "image_id": {
      "type": "string"
    },
    "image_status": {
      "type": "string",
      "enum": [
        "missing",
        "awaiting_permission",
        "awaiting_recreation",
        "ready",
        "rejected"
      ]
    },
    "image_pdf_page": {
      "type": [
        "integer",
        "null"
      ]
    },
    "image_position": {
      "type": "string"
    },
    "image_path": {
      "type": "string"
    },
    "image_source_title": {
      "type": "string"
    },
    "image_source_location": {
      "type": "string"
    },
    "image_license": {
      "type": "string"
    },
    "image_rights_record_id": {
      "type": "string"
    },
    "image_copyright_status": {
      "type": "string"
    },
    "image_attribution": {
      "type": "string"
    },
    "image_alt_text": {
      "type": "string"
    },
    "image_caption": {
      "type": "string"
    },
    "image_width": {
      "type": [
        "integer",
        "null"
      ]
    },
    "image_height": {
      "type": [
        "integer",
        "null"
      ]
    },
    "image_annotations": {
      "type": "array"
    },
    "image_hotspots": {
      "type": "array"
    },
    "image_verified": {
      "type": "boolean"
    },
    "image_accessibility_verified": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "question_type": {
            "enum": [
              "single_choice",
              "multiple_response",
              "true_false"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "choices": {
            "minItems": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provenance": {
            "const": "restricted_do_not_use"
          }
        }
      },
      "then": {
        "properties": {
          "reuse_allowed": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provenance": {
            "const": "provenance_uncertain"
          }
        }
      },
      "then": {
        "properties": {
          "reuse_allowed": {
            "const": false
          },
          "status": {
            "const": "quarantined"
          }
        }
      }
    }
  ]
}
